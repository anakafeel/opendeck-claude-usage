{
  "Name": "Claude Usage",
  "Description": "Animated ring showing Claude 5-hour and 7-day usage limits. Read-only: never refreshes or writes your credentials.",
  "Author": "anakafeel",
  "Version": "1.0.0",
  "Category": "Claude",
  "CategoryIcon": "imgs/plugin",
  "Icon": "imgs/plugin",
  "SDKVersion": 2,
  "Software": { "MinimumVersion": "6.0" },
  "OS": [{ "Platform": "linux" }, { "Platform": "mac", "MinimumVersion": "12" }, { "Platform": "windows", "MinimumVersion": "10" }],
  "CodePath": "plugin.js",
  "CodePathLin": "run.sh",
  "Nodejs": { "Version": "20" },
  "Actions": [
    {
      "Name": "Usage Ring",
      "UUID": "dev.anakafeel.claudeusage.ring",
      "Icon": "imgs/action",
      "Tooltip": "Press: switch 5H / 7D. Hold: refresh.",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "States": [{ "Image": "imgs/action", "ShowTitle": false }]
    }
  ]
}
